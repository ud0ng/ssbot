# ============================================================
# 자동봇 설정 (install.sh 가 대신 만들어 줍니다)
# ============================================================

# ---------------- 마스토돈 ----------------
MASTODON_API_BASE_URL=https://example.com
# 명령어를 받는 메인 봇 계정의 액세스 토큰
MASTODON_ACCESS_TOKEN=

# 예약 툿 · 스토리에서 쓰는 계정 (시트의 '계정' 칸 이름 = ACCOUNT_ 뒤 이름)
# 공지가 전원에게 보이려면 NOTICE 에 공지 계정(manager)의 토큰을 넣으세요.
ACCOUNT_NOTICE=
ACCOUNT_STORY=
ACCOUNT_SYSTEM=
# [스진/워크시트명] DM 을 받는 계정 이름
STORY_ACCOUNT=STORY

# 운영진 아이디 (@ 없이, 쉼표로 여러 명) — 운영진 명령어와 [스진] 사용 가능
ADMIN_IDS=manager
# 한 툿 글자수 (서버 설정과 같게)
MAX_MESSAGE_LENGTH=1000

# ---------------- 구글 시트 ----------------
GOOGLE_CREDENTIALS_PATH=credentials.json
# 비워 둔 시트의 기능은 꺼집니다.
MAIN_SHEET_ID=
RESERVATION_SHEET_ID=
STORY_SHEET_ID=
INVESTIGATION_SHEET_ID=
# 시트 내용을 몇 초 동안 기억할지 (고친 내용을 바로 반영하려면 [캐시 리셋])
CACHE_SECONDS=60

# ---------------- 기능 ----------------
CURRENCY_NAME=코인
TRANSFER_ENABLED=true
# 출석 보상 (0 이면 [출석] 끔)
ATTENDANCE_REWARD=0
# 툿 N개마다 재화 (0 이면 끔)
TOOT_REWARD_EVERY=0
TOOT_REWARD_AMOUNT=1
TOOT_REWARD_INTERVAL_MINUTES=60
# 하루 조사 횟수 (0 이면 제한 없음)
INVESTIGATION_DAILY_LIMIT=0
RANDOMBOX_COMMAND=랜덤박스
KEYWORD_IMAGES=true
# 시트의 '일반' 범위를 실제로 올릴 공개 범위 (이 서버는 unlisted 권장)
PUBLIC_VISIBILITY=unlisted
STORY_VISIBILITY=unlisted
